# MVP는 DB 없이 동작합니다.
# Supabase 결과 저장/공유 URL을 붙일 때만 아래 값을 채우세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 구글폼/관심 등록 링크가 정해지면 넣으세요.
VITE_INTEREST_FORM_URL=

# /admin DB 보정 화면용 서버 환경 변수입니다.
# SUPABASE_SERVICE_ROLE_KEY는 절대 VITE_ prefix로 만들지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_TOKEN=쿨쿨띠
